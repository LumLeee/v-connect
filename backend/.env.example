# Copy to backend/.env. Never commit real passwords.
DJANGO_DEBUG=True
DJANGO_HTTPS=False
FRONTEND_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=v_connect
DB_USER=v_connect
DB_PASSWORD=replace-with-a-random-password
DB_TEST_NAME=test_v_connect
# Used only by scripts/setup_mysql.py, never by the application.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
